# See https://help.github.com/articles/ignoring-files/

# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build outputs ─────────────────────────────────────────────────────────────
/.next/
/out/
/build
/.open-next/
/.wrangler/

# ── Environment & secrets ─────────────────────────────────────────────────────
# Committed: .env.example (safe template, no real values)
# NOT committed: .env, .env.local, .env.*.local, .env.production
.env
.env.local
.env.*.local
.env.production

# ── Testing & coverage ────────────────────────────────────────────────────────
/coverage

# ── TypeScript build cache ────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── OS / Editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── AI agent / IDE tooling (not relevant to contributors) ─────────────────────
/.agent
/.agents
/.kilo
/prompts
/human
AGENTS.md
GEMINI.md
CLAUDE.md