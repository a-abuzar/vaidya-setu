# VaidyaSetu Environment Variables
# ---------------------------------
# Copy this file to .env.local and fill in every value before running the app.
# Never commit .env or .env.local — they are excluded by .gitignore.
#
# All keys below are REQUIRED unless marked optional.

# ── Sarvam AI ─────────────────────────────────────────────────────────────────
# Used for Speech-to-Text (saaras:v3) and Text-to-Speech (bulbul:v3).
# Get your key at: https://console.sarvam.ai
SARVAM_API_KEY=

# ── Groq ──────────────────────────────────────────────────────────────────────
# Used for the primary triage LLM (qwen/qwen3.8-27b).
# Get your key at: https://console.groq.com
GROQ_API_KEY=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Used as the fallback triage model and for clinical summary generation.
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=

# ── Clerk (Authentication) ────────────────────────────────────────────────────
# Protects the physician dashboard at /dashboard.
# Create a new application at: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Neon Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string (serverless Neon or any PostgreSQL 15+ instance).
# Get a free database at: https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── ABDM / NHA (optional for demo) ───────────────────────────────────────────
# Required for ABHA Health ID linking in production.
# Apply for sandbox access at: https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ── Development Flags ─────────────────────────────────────────────────────────
# Set CLERK_BYPASS=true to boot without real Clerk keys (kiosk still works,
# physician dashboard becomes publicly accessible — demo / local dev only).
# NEVER set true in a production deployment.
CLERK_BYPASS=
